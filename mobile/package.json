{
  "name": "@keyvault/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "KeyVault Personal Android client (Capacitor)",
  "scripts": {
    "build:web": "npm run build --prefix .. && node scripts/sync-web.js",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync android && node scripts/install-plugin.js",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android",
    "android:prepare": "npm run build:web && npx cap sync android && node scripts/install-plugin.js && node scripts/setup-android-env.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/clipboard": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/filesystem": "^7.1.1",
    "@keyvault/core": "file:../packages/vault-core",
    "astral-regex": "^2.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0"
  }
}
